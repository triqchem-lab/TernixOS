[submodule "kernel/FreeRTOS-Kernel"]
	path = kernel/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "boot/udk"]
	path = boot/udk
	url = https://github.com/clearnature/udk.git
	branch = trirv
[submodule "boot/rustsbi"]
	path = boot/rustsbi
	url = https://github.com/clearnature/rustsbi.git
